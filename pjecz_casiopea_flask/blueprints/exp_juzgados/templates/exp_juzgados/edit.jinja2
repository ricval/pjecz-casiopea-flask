{% extends 'layouts/app.jinja2' %}
{% import 'macros/form.jinja2' as f with context %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Editar juzgado para expedientes {{ exp_juzgado.nombre }}{% endblock %}

{% block topbar_actions %}
    {{ topbar.page('Editar juzgado para expedientes ' + exp_juzgado.clave) }}
{% endblock %}

{% block content %}
    {% call f.card() %}
        {% set form_kwargs = {'exp_juzgado_id': exp_juzgado.id} %}
        {% call f.form_tag('exp_juzgados.edit', fid='exp_juzgado_form', **form_kwargs) %}
            {% call f.form_group(form.clave) %}{% endcall %}
            {% call f.form_group(form.descripcion_corta) %}{% endcall %}
            {% call f.form_group(form.descripcion) %}{% endcall %}
            {% call f.form_group(form.guardar) %}{% endcall %}
        {% endcall %}
    {% endcall %}
{% endblock %}
