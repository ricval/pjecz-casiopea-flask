{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_admin('EXP JUZGADOS') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('exp_juzgados.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('exp_juzgados.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('EXP JUZGADOS') %}
            {{ topbar.button_new('Nuevo Juzgado', url_for('exp_juzgados.new')) }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros Exp Juzgados -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtosExpJuzgados.buscar(); return false;">
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroClave" type="text" class="form-control" aria-label="Clave" style="text-transform: uppercase;">
                            <label for="filtroClave">Clave</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtroDescripcionCorta" type="text" class="form-control" aria-label="DescripcionCorta" style="text-transform: uppercase;">
                            <label for="filtroDescripcionCorta">Descripción Corta</label>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtosExpJuzgados.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtosExpJuzgados.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable Exp Juzgados -->
        <table id="exp_juzgados_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Descripción Corta</th>
                    <th>Descripción</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <!-- Datatables -->
    <script src="{{ url_for('static', filename='js/datatables-constructor.js') }}"></script>
    <script src="{{ url_for('static', filename='js/datatables-filtros.js') }}"></script>
    <script>
        // DataTable Exp Juzgados
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTExpJuzgados = constructorDataTable.config();
        configDTExpJuzgados['ajax']['url'] = '{{ url_for("exp_juzgados.datatable_json") }}';
        configDTExpJuzgados['ajax']['data'] = {{ filtros }};
        configDTExpJuzgados['columns'] = [
            { data: 'detalle' },
            { data: 'descripcion_corta' },
            { data: 'descripcion' },
        ];
        configDTExpJuzgados['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.clave + '</a>';
                }
            }
        ];
        const filtosExpJuzgados = new FiltrosDataTable('#exp_juzgados_datatable', configDTExpJuzgados);
        filtosExpJuzgados.agregarInput('filtroClave', 'clave');
        filtosExpJuzgados.agregarInput('filtroDescripcionCorta', 'descripcion_corta');
        filtosExpJuzgados.precargar();
    </script>
{% endblock %}
