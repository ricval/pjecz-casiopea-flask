{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_admin('CIT DIAS INHABILES') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('cit_dias_inhabiles.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('cit_dias_inhabiles.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('CIT DIAS INHABILES') %}
            {{ topbar.button_new('Nuevo Dia Inhabil', url_for('cit_dias_inhabiles.new')) }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% if estatus == 'A' %}
    {% call list.card() %}
        <!-- Calendarios Mini de Días Inhábiles -->
        <div class="row align-items-start gx-2">
            <div class="col-auto">
                <button id="cal-btn-prev" class="btn btn-outline-secondary btn-sm" style="margin-top:2.3rem;" title="Mes anterior">
                    <span class="mdi mdi-chevron-left"></span>
                </button>
            </div>
            <div class="col">
                <div class="row" id="calendarios-row">
                    <div class="col-md-6 mb-2">
                        <div id="cal-current"></div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <div id="cal-next"></div>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <button id="cal-btn-next" class="btn btn-outline-secondary btn-sm" style="margin-top:2.3rem;" title="Mes siguiente">
                    <span class="mdi mdi-chevron-right"></span>
                </button>
            </div>
        </div>
    {% endcall %}
    {% endif %}

    {% call list.card() %}
        <!-- Filtros Cit Días Inhábiles -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosCitDiasInhabiles.buscar(); return false;">
                    <div class="col-6">
                        <div class="form-floating">
                            <input id="filtroDescripcion" type="text" class="form-control" aria-label="Descripción" style="text-transform: uppercase;">
                            <label for="filtroDescripcion">Descripción</label>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosCitDiasInhabiles.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosCitDiasInhabiles.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable Cit Días Inhábiles -->
        <table id="cit_dias_inhabiles_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Descripción</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="{{ url_for('static', filename='js/datatables-constructor.js') }}"></script>
    <script src="{{ url_for('static', filename='js/datatables-filtros.js') }}"></script>
    {% if estatus == 'A' %}
    <script>
        // Calendarios Mini de Días Inhábiles
        (function() {
            const canInsert = {{ 'true' if current_user.can_insert('CIT DIAS INHABILES') else 'false' }};
            const urlNuevo = '{{ url_for("cit_dias_inhabiles.new") }}';
            const mapa = {{ dias_inhabiles_json | safe }};
            const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
            const DIAS_CORTO = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];

            function renderCalendario(contenedorId, anio, mes) {
                const contenedor = document.getElementById(contenedorId);
                if (!contenedor) return;
                const hoy = new Date();
                const hoyStr = `${hoy.getFullYear()}-${String(hoy.getMonth()+1).padStart(2,'0')}-${String(hoy.getDate()).padStart(2,'0')}`;
                const numDias = new Date(anio, mes + 1, 0).getDate();
                let inicioCol = new Date(anio, mes, 1).getDay();
                inicioCol = inicioCol === 0 ? 6 : inicioCol - 1; // Lun=0 ... Dom=6

                let html = `<table class="table table-bordered table-sm text-center mb-0" style="font-size:0.82rem;table-layout:fixed;">
                    <thead class="table-light">
                        <tr><th colspan="7" class="py-1 fw-semibold">${MESES[mes]} ${anio}</th></tr>
                        <tr>${DIAS_CORTO.map((d, i) => `<th class="${i >= 5 ? 'text-secondary fw-normal' : 'fw-normal'}" style="font-size:0.75rem;">${d}</th>`).join('')}</tr>
                    </thead>
                    <tbody>`;

                let col = inicioCol;
                let fila = '<tr>';
                for (let i = 0; i < inicioCol; i++) fila += '<td></td>';

                for (let dia = 1; dia <= numDias; dia++) {
                    const fechaStr = `${anio}-${String(mes+1).padStart(2,'0')}-${String(dia).padStart(2,'0')}`;
                    const esFinSemana = col === 5 || col === 6;
                    const esHoy = fechaStr === hoyStr;
                    const esInhabil = Object.prototype.hasOwnProperty.call(mapa, fechaStr);

                    let tdClass = '';
                    let contenido = '';

                    if (esInhabil) {
                        tdClass = 'bg-danger bg-opacity-10';
                        contenido = `<a href="${mapa[fechaStr].url}" class="text-danger text-decoration-none fw-semibold" title="${mapa[fechaStr].desc}">${dia}</a>`;
                    } else {
                        const esPasado = fechaStr < hoyStr;
                        const sinLink = esFinSemana || esPasado;
                        if (sinLink) tdClass = 'text-secondary';
                        else if (esHoy) tdClass = 'bg-primary bg-opacity-10 fw-bold';
                        if (canInsert && !sinLink) {
                            const claseLink = esHoy ? 'text-primary text-decoration-none' : 'text-dark text-decoration-none';
                            contenido = `<a href="${urlNuevo}?fecha=${fechaStr}" class="${claseLink}" title="Agregar día inhábil">${dia}</a>`;
                        } else {
                            contenido = String(dia);
                        }
                    }

                    fila += `<td class="${tdClass}" style="padding:3px 1px;">${contenido}</td>`;
                    col++;

                    if (col === 7) {
                        fila += '</tr>';
                        html += fila;
                        fila = '<tr>';
                        col = 0;
                    }
                }

                if (col > 0) {
                    for (let i = col; i < 7; i++) fila += '<td></td>';
                    fila += '</tr>';
                    html += fila;
                }

                html += '</tbody></table>';
                contenedor.innerHTML = html;
            }

            const ahora = new Date();
            const anioBase = ahora.getFullYear();
            const mesBase = ahora.getMonth();
            let offsetMeses = 0;

            function mesConOffset(offset) {
                const total = mesBase + offset;
                const mes = ((total % 12) + 12) % 12;
                const anio = anioBase + Math.floor(total / 12);
                return { anio, mes };
            }

            function actualizarCalendarios() {
                const m1 = mesConOffset(offsetMeses);
                const m2 = mesConOffset(offsetMeses + 1);
                renderCalendario('cal-current', m1.anio, m1.mes);
                renderCalendario('cal-next', m2.anio, m2.mes);
            }

            document.getElementById('cal-btn-prev').addEventListener('click', function() {
                offsetMeses--;
                actualizarCalendarios();
            });
            document.getElementById('cal-btn-next').addEventListener('click', function() {
                offsetMeses++;
                actualizarCalendarios();
            });

            actualizarCalendarios();
        })();
    </script>
    {% endif %}
    <script>
        // DataTable Cit Días Inhábiles
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTCitDiasInhabiles = constructorDataTable.config();
        configDTCitDiasInhabiles['ajax']['url'] = '{{ url_for("cit_dias_inhabiles.datatable_json") }}';
        configDTCitDiasInhabiles['ajax']['data'] = {{ filtros }};
        configDTCitDiasInhabiles['columns'] = [
            { data: 'detalle' },
            { data: 'descripcion' }
        ];
        configDTCitDiasInhabiles['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + moment(data.fecha).format('YYYY-MM-DD, ddd') + '</a>';
                }
            }
        ];
        // Filtros Cit Días Inhábiles
        const filtrosCitDiasInhabiles = new FiltrosDataTable('#cit_dias_inhabiles_datatable', configDTCitDiasInhabiles);
        filtrosCitDiasInhabiles.agregarInput('filtroDescripcion', 'descripcion');
        filtrosCitDiasInhabiles.precargar();
    </script>
{% endblock %}
