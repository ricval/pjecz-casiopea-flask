<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Captura de Asistencia</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Material Design Icons -->
    <link href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css" rel="stylesheet">
    
    <style>
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden; /* Evita barras de scroll */
        }
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
        }
        .capture-container {
            text-align: center;
            width: 100%;
            max-width: 800px; /* Ancho máximo del contenedor */
            padding: 20px;
        }
        .barcode-input {
            font-size: 2.5rem; /* Tamaño de fuente más grande */
            text-align: center;
            height: auto;
            padding: 0.75rem 1.25rem;
        }
        .action-buttons {
            position: fixed;
            bottom: 1rem;
            left: 1rem;
        }
        .action-buttons .btn {
            color: #adb5bd; /* Color de icono gris claro */
            background-color: transparent;
            border: none;
            font-size: 1.5rem; /* Tamaño de icono */
            padding: 0.25rem 0.5rem;
        }
        .action-buttons .btn:hover,
        .action-buttons .btn:focus {
            color: #495057; /* Color más oscuro al pasar el mouse o enfocar */
            box-shadow: none;
        }
    </style>
</head>
<body>

    <div class="capture-container">
        <h2 class="mb-4 text-secondary">Escanee su código de barras de asistencia</h2>
        <form action="/admin/cit_citas_turnos/crear_turno" method="post" id="barcode-form" role="form" autocomplete="off">
            <input id="csrf_token" name="csrf_token" type="hidden" value="{{ csrf_token() }}">
            <input type="text" class="form-control barcode-input" id="barcode" name="barcode" autofocus>
        </form>
    </div>

    <div class="action-buttons">
        <button type="button" class="btn" title="Configuración">
            <i class="mdi mdi-cog"></i>
        </button>
        <button type="submit" form="barcode-form" class="btn" title="Test">
            <i class="mdi mdi-check"></i>
        </button>
    </div>

</body>
</html>