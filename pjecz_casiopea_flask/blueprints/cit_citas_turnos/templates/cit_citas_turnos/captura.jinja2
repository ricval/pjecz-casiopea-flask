<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>SAJI Citas — Control de Acceso</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
        <style>
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    font-family: 'Inter', sans-serif;
    background: #f5f5f5;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.wrap {
    background: #f5f5f5;
    overflow: hidden;
    border-radius: 0;
    width: 100%;
}

.pj-header {
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    padding: 12px 24px;
    display: flex;
    align-items: center;
}
.pj-logo img { height: 40px; display: block; }

.pj-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 65px);
}

/* ── PANEL IZQUIERDO ── */
.pj-left {
    padding: 28px 24px;
    border-right: 0.5px solid #e0e0e0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: #fff;
}

/* ── PANEL DERECHO ── */
.pj-right {
    padding: 28px 24px;
    background: #fafafa;
    position: relative;
}

.section-lbl {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .8px;
    color: #999;
    margin-bottom: 8px;
}

.right-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.pj-sub {
    font-size: 14px;
    color: #888;
    margin-bottom: 44px;
}

/* ── SCANNER ── */
.scanner-area {
    border: 1.5px dashed #ccc;
    border-radius: 12px;
    padding: 64px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    transition: all .2s;
}
.scanner-area.active { border-color: #111; border-style: solid; background: rgba(0,0,0,.03); }
.scanner-area.ok     { border-color: #1d9e75; border-style: solid; background: rgba(29,158,117,.06); }
.scanner-area.err    { border-color: #d85a30; border-style: solid; background: rgba(216,90,48,.04); }

.scan-icon {
    width: 80px; height: 80px;
    border-radius: 18px;
    background: #f0f0f0;
    display: flex; align-items: center; justify-content: center;
}
.scan-icon i { font-size: 40px; color: #555; }
.scan-icon.ok  { background: #eafaf4; }
.scan-icon.ok i  { color: #1d9e75; }
.scan-icon.err { background: #fdf0eb; }
.scan-icon.err i { color: #d85a30; }

.scanner-label { font-size: 15px; font-weight: 600; color: #111; }
.scanner-label.ok-text { color: #1d9e75; }

.hidden-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px; height: 1px;
}

/* ── PROGRESS ── */
.progress-wrap { display: none; }
.progress-wrap.visible { display: block; }
.progress-track {
    width: 100%; height: 4px;
    background: #e0e0e0;
    border-radius: 4px;
    overflow: hidden;
}
.progress-bar {
    height: 100%;
    background: #111;
    border-radius: 4px;
    width: 100%;
    transition: width linear;
}

/* ── BADGE ── */
.badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 14px; border-radius: 999px;
    font-size: 13px; font-weight: 600; letter-spacing: .2px;
}
.badge.ok  { background: #111; color: #fff; }
.badge.err { background: #fdf0eb; color: #d85a30; }

/* ── ESTADOS VACÍO / ERROR ── */
.cita-empty {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 8px; height: 100%;
    color: #bbb; text-align: center;
}
.cita-empty i { font-size: 40px; }
.cita-empty p { font-size: 16px; }

.error-block {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px; height: 100%; text-align: center;
}
.error-block i { font-size: 40px; color: #d85a30; }
.error-block p { font-size: 14px; font-weight: 600; color: #d85a30; }

/* ── CITA CARD ── */
.cita-card {
    display: flex; flex-direction: column; gap: 0;
    animation: fi .3s ease;
    background: #fff;
    border: 0.5px solid #e4e4e4;
    border-radius: 14px;
    overflow: hidden;
}
@keyframes fi {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* Persona */
.persona-row {
    display: flex; align-items: center; gap: 12px;
    padding: 18px 18px 14px;
    border-bottom: 0.5px solid #f0f0f0;
}
.avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: #e8e8e8; color: #555;
    font-weight: 700; font-size: 15px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.persona-name { font-size: 15px; font-weight: 600; color: #111; margin-bottom: 3px; }
.persona-meta {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; color: #888;
}
.persona-meta span { display: flex; align-items: center; gap: 4px; }
.persona-meta i { font-size: 12px; }

/* Fecha / Hora */
.datetime-row {
    display: grid; grid-template-columns: 1fr 1fr;
    border-bottom: 0.5px solid #f0f0f0;
}
.dt-cell {
    padding: 12px 18px;
    display: flex; align-items: center; gap: 10px;
}
.dt-cell:first-child { border-right: 0.5px solid #f0f0f0; }
.dt-icon {
    width: 32px; height: 32px; border-radius: 8px;
    background: #f5f5f5;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.dt-icon i { font-size: 16px; color: #555; }
.dt-lbl { font-size: 10px; color: #aaa; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 1px; }
.dt-val { font-size: 14px; font-weight: 600; color: #111; }

/* Filas de info */
.info-row {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 11px 18px;
    border-bottom: 0.5px solid #f0f0f0;
}
.info-row:last-of-type { border-bottom: none; }
.info-icon { margin-top: 1px; flex-shrink: 0; }
.info-icon i { font-size: 16px; color: #aaa; }
.info-lbl { font-size: 10px; color: #aaa; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px; }
.info-val { font-size: 13px; font-weight: 500; color: #111; line-height: 1.4; }

/* Turno */
.turno-block {
    margin: 0 18px 18px;
    border: 0.5px solid #e8e8e8;
    background: #fafafa;
    border-radius: 10px;
    padding: 16px;
    text-align: center;
}
.turno-lbl { font-size: 11px; color: #aaa; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px; }
.turno-num { font-family: 'JetBrains Mono', monospace; font-size: 44px; font-weight: 700; color: #111; line-height: 1; }

/* ── BOTONES ── */
.action-buttons {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    gap: 4px;
}
.action-buttons a {
    display: inline-flex;
    align-items: center;
    padding: 6px 8px;
    border-radius: 8px;
    color: #adb5bd;
    font-size: 20px;
    text-decoration: none;
    transition: color .15s, background .15s;
}
.action-buttons a:hover { color: #495057; background: rgba(0,0,0,.05); }
        </style>
    </head>
    <body>

    <div class="wrap">
        <div class="pj-header">
            <div class="pj-logo">
                <img src="https://citas.saji.gob.mx/images/logo_navbar.png" alt="SAJI Citas" />
            </div>
        </div>

        <div class="pj-body">

            <!-- PANEL IZQUIERDO: Formulario de escaneo -->
            <div class="pj-left">
                <div class="section-lbl">Confirme su cita</div>

                {% if cit_cita %}
                <div class="scanner-area ok" id="scanZone">
                    <div class="scan-icon ok" id="scanIcWrap">
                        <i class="ti ti-check" id="scanIco"></i>
                    </div>
                    <div class="scanner-label ok-text" id="scanLabel">Cita verificada</div>
                </div>
                {% elif error %}
                <div class="scanner-area err" id="scanZone">
                    <div class="scan-icon err" id="scanIcWrap">
                        <i class="ti ti-alert-triangle" id="scanIco"></i>
                    </div>
                    <div class="scanner-label" id="scanLabel">Código no válido</div>
                </div>
                {% else %}
                <div class="scanner-area" id="scanZone">
                    <div class="scan-icon" id="scanIcWrap">
                        <i class="ti ti-barcode" id="scanIco"></i>
                    </div>
                    <div class="scanner-label" id="scanLabel">
                        Escanee el código de barras
                        <p class="pj-sub">Apunte la pistola lectora al código de su cita</p>
                    </div>
                </div>
                {% endif %}

                <form action="{{ url_for('cit_citas_turnos.captura') }}" method="post" id="barcode-form" autocomplete="off">
                    <input id="csrf_token" name="csrf_token" type="hidden" value="{{ csrf_token() }}" />
                    <input type="text" class="hidden-input" id="barcode" name="barcode" />
                </form>

                <div class="progress-wrap" id="progressWrap">
                    <div class="progress-track">
                        <div class="progress-bar" id="progressBar"></div>
                    </div>
                </div>
            </div>

            <!-- PANEL DERECHO: Información de la cita -->
            <div class="pj-right">

                <div class="right-header">
                    <div class="section-lbl" style="margin-bottom:0;">Información de la cita</div>
                    {% if cit_cita %}
                    <span class="badge ok">
                        <i class="ti ti-circle-check" style="font-size:13px;"></i>
                        Confirmada
                    </span>
                    {% elif error %}
                    <span class="badge err">
                        <i class="ti ti-alert-circle" style="font-size:13px;"></i>
                        No válida
                    </span>
                    {% endif %}
                </div>

                <div id="citaContent" style="height: calc(100% - 38px);">

                    {% if cit_cita %}
                    <div class="cita-card">

                        <!-- Persona -->
                        <div class="persona-row">
                            {% set palabras = cit_cita.cit_cliente.nombre.split() %}
                            {% set iniciales = (palabras[0][0] if palabras|length > 0 else '') + (palabras[1][0] if palabras|length > 1 else '') %}
                            <div class="avatar">{{ iniciales | upper }}</div>
                            <div>
                                <div class="persona-name">{{ cit_cita.cit_cliente.nombre }}</div>
                                <div class="persona-meta">
                                    <span><i class="ti ti-phone"></i> {{ cit_cita.cit_cliente.telefono }}</span>
                                    <span><i class="ti ti-mail"></i> {{ cit_cita.cit_cliente.email }}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Fecha y hora -->
                        <div class="datetime-row">
                            <div class="dt-cell">
                                <div class="dt-icon"><i class="ti ti-calendar"></i></div>
                                <div>
                                    <div class="dt-lbl">Fecha</div>
                                    <div class="dt-val">{{ cit_cita.inicio.strftime('%d/%m/%Y') }}</div>
                                </div>
                            </div>
                            <div class="dt-cell">
                                <div class="dt-icon"><i class="ti ti-clock"></i></div>
                                <div>
                                    <div class="dt-lbl">Hora</div>
                                    <div class="dt-val">{{ cit_cita.inicio.strftime('%H:%M') }}</div>
                                </div>
                            </div>
                        </div>

                        <!-- Unidad -->
                        <div class="info-row">
                            <div class="info-icon"><i class="ti ti-building-bank"></i></div>
                            <div>
                                <div class="info-lbl">Unidad</div>
                                <div class="info-val">{{ cit_cita.oficina.descripcion_corta }}</div>
                            </div>
                        </div>

                        <!-- Tipo de trámite -->
                        <div class="info-row">
                            <div class="info-icon"><i class="ti ti-file-description"></i></div>
                            <div>
                                <div class="info-lbl">Tipo de trámite</div>
                                <div class="info-val">{{ cit_cita.cit_servicio.descripcion }}</div>
                            </div>
                        </div>

                        <!-- Notas / Expedientes -->
                        {% if cit_cita.notas %}
                        <div class="info-row">
                            <div class="info-icon">
                                {% if '(' in cit_cita.notas %}
                                <i class="ti ti-files"></i>
                                {% else %}
                                <i class="ti ti-note"></i>
                                {% endif %}
                            </div>
                            <div>
                                <div class="info-lbl">
                                    {% if '(' in cit_cita.notas %}Expedientes{% else %}Notas{% endif %}
                                </div>
                                <div class="info-val">{{ cit_cita.notas }}</div>
                            </div>
                        </div>
                        {% endif %}

                        <!-- Turno -->
                        {% if cit_cita.turno %}
                        <div class="turno-block">
                            <div class="turno-lbl">Turno asignado</div>
                            <div class="turno-num">{{ cit_cita.turno }}</div>
                        </div>
                        {% endif %}

                    </div>

                    {% elif error %}
                    <div class="error-block">
                        <i class="ti ti-alert-circle"></i>
                        <p>{{ error }}</p>
                    </div>

                    {% else %}
                    <div class="cita-empty">
                        <i class="ti ti-qrcode"></i>
                        <p>Escanee el código de barras<br>para ver la información de la cita</p>
                    </div>
                    {% endif %}

                </div>
            </div>

        </div>
    </div>

    <!-- Botones de acción -->
    <div class="action-buttons">
        <a href="{{ url_for('cit_citas_turnos.config', paso_id=1) }}" title="Configuración">
            <i class="ti ti-settings"></i>
        </a>
        <a href="{{ url_for('cit_citas_turnos.tests') }}" title="Test">
            <i class="ti ti-check"></i>
        </a>
    </div>

    <script>
        const RESET_SECS = 10;

        const inp    = document.getElementById('barcode');
        const form   = document.getElementById('barcode-form');
        const zone   = document.getElementById('scanZone');
        const icWrap = document.getElementById('scanIcWrap');
        const ico    = document.getElementById('scanIco');
        const label  = document.getElementById('scanLabel');

        inp.focus();
        document.addEventListener('click', () => inp.focus());

        let scanDebounce = null;

        inp.addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                clearTimeout(scanDebounce);
                const val = inp.value.trim().toUpperCase();
                if (!val) return;
                form.submit();
            }
        });

        inp.addEventListener('input', () => {
            if (!inp.value.trim()) return;
            clearTimeout(scanDebounce);
            setZone('active', '', 'ti-scan');
            label.textContent = 'Leyendo código...';
            scanDebounce = setTimeout(() => form.submit(), 200);
        });

        {% if cit_cita or error %}
        startProgress();
        {% endif %}

        function startProgress() {
            const wrap = document.getElementById('progressWrap');
            const bar  = document.getElementById('progressBar');
            wrap.classList.add('visible');
            bar.style.transition = 'none';
            bar.style.width = '100%';
            setTimeout(() => {
                bar.style.transition = `width ${RESET_SECS}s linear`;
                bar.style.width = '0%';
            }, 30);
            setTimeout(reset, RESET_SECS * 1000);
        }

        function reset() {
            window.location.href = window.location.pathname;
        }

        function setZone(zoneClass, icClass, icoClass) {
            zone.className   = 'scanner-area ' + zoneClass;
            icWrap.className = 'scan-icon ' + icClass;
            ico.className    = 'ti ' + icoClass;
        }
    </script>

    </body>
</html>